# Frontend environment variables
# Copy to .env.local (not committed) for local dev overrides.

# Base URL for materials (PDF proxy) server. For ngrok tunnel, replace with https://<your-subdomain>.ngrok.app
REACT_APP_MATERIALS_URL=http://localhost:3001

# Reserved for future dynamic songs API endpoint (currently songs are statically imported)
REACT_APP_API_URL=http://localhost:3001
